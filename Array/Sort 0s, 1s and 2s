class Solution {
    public void sort012(int[] arr) {
        
        int n = arr.length;
        
        int i = 0, j = n-1, k = 0;
        
        while(k <= j){
            
            if(arr[k] == 0){
                
                int temp = arr[k];
                arr[k] = arr[i];
                arr[i] = temp;
                
                i++;
                k++;
            }
            
            else if(arr[k] == 2){
                
                    int temp = arr[k];
                    arr[k] = arr[j];
                    arr[j] = temp;
                    j--;
                // }
                
            }else{
                k++;
            }
        }
    }
}
